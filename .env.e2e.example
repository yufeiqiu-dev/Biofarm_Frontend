# Credentials for the Playwright suite. Copy to .env.e2e, which is gitignored.
#
# Locally this is the Cognito user you created by hand. Against staging it is
# the account the CDK seeds - read its generated password with:
#   python scripts/seed_test_users.py --profile <p> --show-password customer
E2E_EMAIL=testUser@example.com
E2E_PASSWORD=

# Defaults to http://localhost:5174.
# E2E_BASE_URL=
